# Fairhour environment variables.
#
#   cp .env.example .env
#
# The defaults below work with `docker compose up -d` (Postgres + Mailpit) for local development.
# Never commit `.env`; never put a real secret in this file.
#
# "Used from" names the backlog item / phase that starts reading the variable (see
# .github/backlog). Variables that are empty or unset leave the feature off. Variables that only
# exist in CI (NPM_TOKEN, CODECOV_TOKEN, desktop signing keys, ...) are repository secrets and are
# documented in docs/maintainers/.

# --- Core ----------------------------------------------------------------------------------------

# Public base URL of the web app, without a trailing slash. Used for links in emails, OAuth
# callbacks and cookie settings. Set it to your public https URL when self-hosting.
# Used from: DATA-006 (authentication), WEB-002 (app shell).
APP_URL=http://localhost:3000

# Log level of the pino logger: trace, debug, info, warn, error, fatal or silent.
# Used from: DATA-006 (basic logging), HARD-006 (redaction, tracing).
LOG_LEVEL=debug

# Public demo mode: disables destructive settings and outgoing email. Leave false when you use
# Fairhour for real.
# Used from: LAUNCH-003 (demo data and public demo).
DEMO_MODE=false

# --- Database (PostgreSQL 16) --------------------------------------------------------------------

# Connection string of the application database.
# Used from: DATA-002 (schema), DATA-003 (migrations).
DATABASE_URL=postgres://fairhour:fairhour@localhost:5432/fairhour

# Database for `pnpm test:integration` (created by docker/postgres/initdb). It is migrated and
# truncated freely, so never point it at real data. Falls back to DATABASE_URL when unset, which is
# what CI relies on (it provisions an empty database and sets only DATABASE_URL).
# Used from: DATA-004 (tenant isolation tests).
TEST_DATABASE_URL=postgres://fairhour:fairhour@localhost:5432/fairhour_test

# Apply pending migrations automatically when the server starts. Recommended for self-hosting;
# keep false in development and run `pnpm db:migrate` yourself.
# Used from: DATA-003 (migrate on boot), HOST-003 (production compose).
MIGRATE_ON_BOOT=false

# --- Authentication (Better Auth) ----------------------------------------------------------------

# Secret that signs sessions and tokens. Generate one with `openssl rand -base64 32` and keep it
# stable: changing it signs everybody out. The value below is a placeholder, not a secret; replace
# it before running anywhere but your own machine.
# Used from: DATA-006 (authentication).
BETTER_AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32

# Google OAuth sign-in. The provider is enabled only when both values are set.
# Callback URL: ${APP_URL}/api/auth/callback/google
# Used from: DATA-006 (authentication).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth sign-in. The provider is enabled only when both values are set.
# Callback URL: ${APP_URL}/api/auth/callback/github
# Used from: DATA-006 (authentication).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (SMTP) --------------------------------------------------------------------------------

# Outgoing email: magic sign-in links and account notifications. In development Mailpit (docker compose)
# catches everything: read it at http://localhost:8025. SMTP_USER and SMTP_PASSWORD stay empty for
# servers without authentication (such as Mailpit).
# Used from: DATA-006 (magic links).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Fairhour <no-reply@fairhour.localhost>"

# --- Rate limiting -------------------------------------------------------------------------------

# Requests allowed per window, per client, on sign-in / magic-link / token endpoints.
# Used from: HARD-005 (rate limiting).
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Requests allowed per window, per API token, on the public REST API.
# Used from: HARD-005 (rate limiting), API-002 (public API).
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_SECONDS=60

# Where the counters live: "memory" (default, one instance) or "postgres" (several instances).
# Used from: HARD-005 (rate limiting).
RATE_LIMIT_STORE=memory

# --- Reports -------------------------------------------------------------------------------------

# Secret that signs read-only report share links (HMAC). Generate one with
# `openssl rand -base64 32`. Changing it invalidates every existing link. The value below is a
# placeholder, not a secret.
# Used from: REP-006 (share links).
SHARE_LINK_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32

# --- Observability (all optional, off when empty) ------------------------------------------------

# Sentry-compatible DSN for error reporting. Nothing is sent without it.
# Used from: HARD-006 (observability).
SENTRY_DSN=

# OpenTelemetry collector endpoint (OTLP over HTTP), for example http://localhost:4318. Tracing is
# off without it.
# Used from: HARD-006 (observability).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fairhour-web

# --- Tooling (optional) --------------------------------------------------------------------------

# Opt out of anonymous telemetry from the build tools (CI already sets both).
# TURBO_TELEMETRY_DISABLED=1
# NEXT_TELEMETRY_DISABLED=1

{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "TURBO_TELEMETRY_DISABLED",
    "NEXT_TELEMETRY_DISABLED",
    "ASTRO_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"],
      "passThroughEnv": [
        "APP_URL",
        "LOG_LEVEL",
        "DEMO_MODE",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "MIGRATE_ON_BOOT",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "RATE_LIMIT_AUTH_MAX",
        "RATE_LIMIT_AUTH_WINDOW_SECONDS",
        "RATE_LIMIT_API_MAX",
        "RATE_LIMIT_API_WINDOW_SECONDS",
        "RATE_LIMIT_STORE",
        "SHARE_LINK_SECRET",
        "SENTRY_DSN",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME"
      ]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": [
        "APP_URL",
        "LOG_LEVEL",
        "DEMO_MODE",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "MIGRATE_ON_BOOT",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "RATE_LIMIT_AUTH_MAX",
        "RATE_LIMIT_AUTH_WINDOW_SECONDS",
        "RATE_LIMIT_API_MAX",
        "RATE_LIMIT_API_WINDOW_SECONDS",
        "RATE_LIMIT_STORE",
        "SHARE_LINK_SECRET",
        "SENTRY_DSN",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME"
      ]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "APP_URL",
        "LOG_LEVEL",
        "DEMO_MODE",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "MIGRATE_ON_BOOT",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "RATE_LIMIT_AUTH_MAX",
        "RATE_LIMIT_AUTH_WINDOW_SECONDS",
        "RATE_LIMIT_API_MAX",
        "RATE_LIMIT_API_WINDOW_SECONDS",
        "RATE_LIMIT_STORE",
        "SHARE_LINK_SECRET",
        "SENTRY_DSN",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_URL",
        "LOG_LEVEL",
        "DEMO_MODE",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "MIGRATE_ON_BOOT",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "RATE_LIMIT_AUTH_MAX",
        "RATE_LIMIT_AUTH_WINDOW_SECONDS",
        "RATE_LIMIT_API_MAX",
        "RATE_LIMIT_API_WINDOW_SECONDS",
        "RATE_LIMIT_STORE",
        "SHARE_LINK_SECRET",
        "SENTRY_DSN",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_SERVICE_NAME"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}

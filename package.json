{
  "name": "fairhour",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source time tracking that tells you exactly what to invoice. Every hour, fairly billed.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiovincenzi/fairhour.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "knip": "knip",
    "i18n:check": "node scripts/i18n/check-locales.ts",
    "backlog:validate": "pnpm --filter @fairhour/github-scripts backlog:validate",
    "db:migrate": "pnpm --filter @fairhour/db --if-present db:migrate",
    "db:seed": "pnpm --filter @fairhour/db --if-present db:seed",
    "db:generate": "pnpm --filter @fairhour/db --if-present db:generate",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "node scripts/github/src/cli/release-publish.ts",
    "prepare": "node --eval \"if (!process.env.CI && fs.existsSync('.git')) { try { child_process.execSync('lefthook install', { stdio: 'inherit' }) } catch {} }\""
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fairhour/config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}

{
  "name": "@fairhour/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, ESLint, Prettier, tsdown and Tailwind presets for Fairhour.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js",
    "./tsdown": "./tsdown.js",
    "./tsconfig/*": "./tsconfig/*",
    "./tailwind/theme.css": "./tailwind/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node --eval \"fs.rmSync('coverage', { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    }
  }
}

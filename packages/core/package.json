{
  "name": "@fairhour/core",
  "version": "0.0.0",
  "private": true,
  "description": "Fairhour domain logic: time math, rounding, overlaps, rates, budgets, quick add and invoice drafts.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiovincenzi/fairhour.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "node --eval \"for (const d of ['dist','coverage']) fs.rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fairhour/money": "workspace:*",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fairhour/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}

{
  "name": "@fairhour/tax-pack-template",
  "version": "0.1.0",
  "private": true,
  "description": "Template for new Fairhour country tax packs: copy it, replace the TEMPLATE markers, pass the conformance suite.",
  "keywords": [
    "fairhour",
    "tax",
    "template"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiovincenzi/fairhour.git",
    "directory": "packages/tax-pack-template"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "node --eval \"for (const d of ['dist','coverage']) fs.rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fairhour/money": "workspace:*",
    "@fairhour/tax-core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fairhour/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}

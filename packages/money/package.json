{
  "name": "@fairhour/money",
  "version": "0.0.0",
  "private": true,
  "description": "Exact money and decimal arithmetic on bigint minor units, with explicit rounding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiovincenzi/fairhour.git",
    "directory": "packages/money"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./zod": {
      "types": "./src/zod.ts",
      "default": "./src/zod.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./zod": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "node --eval \"for (const d of ['dist','coverage']) fs.rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fairhour/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
